{
  "name": "@orbit/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./permissions": "./src/permissions.ts",
    "./roles": "./src/roles.ts",
    "./chat-types": "./src/chat-types.ts",
    "./meeting-types": "./src/meeting-types.ts"
  },
  "scripts": {
    "db:dev": "node scripts/dev-db.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "embedded-postgres": "18.6.0-beta.19",
    "prisma": "7.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}

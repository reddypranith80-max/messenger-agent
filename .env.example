# Copy to .env (repo root) and fill in. Never commit .env.

# --- Database (Postgres: Neon, Supabase, or `pnpm db:dev` for a local one) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/orbit?sslmode=require"

# --- Clerk (https://dashboard.clerk.com → API keys) ---
# Leave both empty in development to use Clerk's keyless mode (temporary keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Webhook endpoint: <app url>/api/webhooks/clerk (user.*, organization.*, organizationMembership.*)
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- App URLs ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"

# --- Realtime service (apps/realtime) ---
REALTIME_PORT="4000"
WEB_ORIGIN="http://localhost:3000"
# Optional in dev; required when running more than one realtime instance.
REDIS_URL="redis://localhost:6379"

# --- Calls and meeting rooms (https://cloud.livekit.io → project → Settings → Keys) ---
# Until these are real values, chat and scheduling work and call screens explain what is missing.
LIVEKIT_URL="wss://xxx.livekit.cloud"
LIVEKIT_API_KEY="xxx"
LIVEKIT_API_SECRET="xxx"

# --- Meeting invitation and reminder emails (https://resend.com) ---
# Optional: without a real key, invitations and reminders are shown in the app only.
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Orbit <noreply@example.com>"

# --- Not used yet (file uploads, billing) ---
R2_ACCOUNT_ID="xxx"
R2_ACCESS_KEY_ID="xxx"
R2_SECRET_ACCESS_KEY="xxx"
R2_BUCKET="orbit-uploads"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
